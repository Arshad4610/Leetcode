from itertools import combinations
l=['a','b','c','d',4,'ab','c','cd','c']
z=l[0:4]
n=l[4]
li=l[5:9]
target=''.join(map(str,z))
for i in range(1,len(li)+1):
    for j in combinations(li,i):
        if(''.join(j)==target):
            print(i)
            print(j)
            exit()
-----------------------------------------------------------------------------------------------------------
OUTPUT:
      Min no.of elements= 2
      Elements used= ('ab', 'cd')
